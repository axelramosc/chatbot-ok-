# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code — config y cuaderno de trabajo locales.
# Se versionan settings.json, agents/ y skills/ (CLAUDE.md los da por existentes);
# lo de abajo es de la máquina de cada quien o envejece mal.
.claude/settings.local.json
.claude/agent-memory/

# capturas de automatización (playwright y similares)
scripts/*.png
